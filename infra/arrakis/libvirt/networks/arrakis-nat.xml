<!--
  arrakis-nat: the private network the VMs use.

  Why NAT and not a bridge: this machine reaches the internet over Wi-Fi, and a
  Wi-Fi client interface cannot be bridged. See network/README.md section 2.

  <forward mode='nat'/> tells libvirt to rewrite the sender address on the way
  out, so the VMs share the host's Wi-Fi address.

  The <dhcp> range gives each VM an address automatically. The three <host>
  entries pin one address per VM, so they never move.

  Apply with:
    virsh net-define libvirt/networks/arrakis-nat.xml
    virsh net-start arrakis-nat
    virsh net-autostart arrakis-nat
-->
<network>
  <name>arrakis-nat</name>
  <forward mode='nat'>
    <nat>
      <port start='1024' end='65535'/>
    </nat>
  </forward>
  <bridge name='virbr-arrakis' stp='on' delay='0'/>
  <ip address='10.10.10.1' netmask='255.255.255.0'>
    <dhcp>
      <range start='10.10.10.100' end='10.10.10.200'/>
      <host mac='52:54:00:10:10:11' name='mentat'  ip='10.10.10.11'/>
      <host mac='52:54:00:10:10:12' name='windtrap' ip='10.10.10.12'/>
      <host mac='52:54:00:10:10:13' name='sietch' ip='10.10.10.13'/>
      <host mac='52:54:00:10:10:14' name='shieldwall' ip='10.10.10.14'/>
    </dhcp>
  </ip>
</network>
