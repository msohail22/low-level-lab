{
	"name": "low-level-lab",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"packageManager": "pnpm@11.22.0",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"lint": "eslint .",
		"preview": "pnpm run build && vite preview",
		"deploy": "pnpm run build && wrangler deploy",
		"cf-typegen": "wrangler types",
		"drizzle:generate": "node --env-file-if-exists=.dev.vars ./node_modules/drizzle-kit/bin.cjs generate",
		"drizzle:push": "node --env-file-if-exists=.dev.vars ./node_modules/drizzle-kit/bin.cjs push"
	},
	"dependencies": {
		"@better-auth/drizzle-adapter": "^1.7.4",
		"@hookform/resolvers": "^5.9.1",
		"@tanstack/react-query": "^5.102.8",
		"better-auth": "^1.7.4",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"drizzle-orm": "^0.45.2",
		"hono": "^4.13.7",
		"jotai": "^3.0.0",
		"lucide-react": "^1.45.0",
		"pg": "^8.23.0",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-hook-form": "^7.88.0",
		"react-router-dom": "^7.18.3",
		"resend": "^6.28.0",
		"tailwind-merge": "^3.6.0",
		"tw-animate-css": "^1.4.0",
		"zod": "^4.6.2"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.54.8",
		"@eslint/js": "^10.0.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^24.13.4",
		"@types/pg": "^8.23.1",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"@vitejs/plugin-react": "^6.1.0",
		"drizzle-kit": "^0.31.10",
		"eslint": "^10.9.0",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-refresh": "^0.5.4",
		"globals": "^17.11.0",
		"shadcn": "^4.21.0",
		"tailwindcss": "^4.3.3",
		"typescript": "~6.0.2",
		"typescript-eslint": "^8.67.0",
		"vite": "^8.2.2",
		"wrangler": "^4.131.1"
	}
}
