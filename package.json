{
  "name": "low-level-lab",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "pnpm --dir apps/mobile test",
    "lint": "pnpm --dir apps/web lint && pnpm --dir apps/api typecheck",
    "build": "pnpm --dir apps/web build",
    "migrate": "pnpm --dir apps/api migrate",
    "db:push": "pnpm --dir apps/api db:push",
    "deploy": "pnpm run deploy:dev",
    "deploy:api": "pnpm --dir apps/api deploy:dev",
    "deploy:web": "pnpm --dir apps/web deploy:dev",
    "deploy:dev": "pnpm run deploy:api && pnpm run deploy:web",
    "dev:api": "pnpm --dir apps/api dev",
    "dev:web": "pnpm --dir apps/web dev",
    "sonar:up": "docker compose up -d",
    "sonar:down": "docker compose down",
    "sonar:logs": "docker compose logs -f sonarqube",
    "sonar:scan": "test -n \"$SONAR_TOKEN\" || (echo 'Set SONAR_TOKEN before running a scan' && exit 1); SONAR_SCANNER_UID=$(id -u) docker compose --profile scan run --rm scanner"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.30.0"
}
