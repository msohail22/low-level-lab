model
  schema 1.1

type user

type organization
  relations
    define super_admin: [user]
    define admin: [user]
    define reviewer: [user]
    define member: [user]

    define can_manage_users: super_admin
    define can_assign_roles: super_admin
    define can_manage_topics: super_admin or admin
    define can_create_question: super_admin or admin or member
    define can_edit_question: super_admin or admin
    define can_submit_question: super_admin or admin or member
    define can_review_question: super_admin or reviewer
    define can_approve_question: super_admin or admin
    define can_publish_question: super_admin

type topic
  relations
    define organization: [organization]
    define admin: [user]
    define reviewer: [user]

    define can_manage_topics: admin or organization->can_manage_topics
    define can_create_question: admin or organization->can_create_question
    define can_review_question: reviewer or organization->can_review_question
    define can_approve_question: admin or organization->can_approve_question
    define can_publish_question: organization->can_publish_question

type question
  relations
    define topic: [topic]
    define author: [user]

    define can_create_question: topic->can_create_question
    define can_edit_question: author or topic->can_manage_topics
    define can_submit_question: author or topic->can_create_question
    define can_review_question: topic->can_review_question
    define can_approve_question: topic->can_approve_question
    define can_publish_question: topic->can_publish_question
