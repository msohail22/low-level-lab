node_modules
.env*
!**/.env.example
.next
next-env.d.ts
.vinext/
.cloudflare/
tsconfig.tsbuildinfo

# wrangler files
.wrangler
.dev.vars*
!.dev.vars.example

# Local agent instructions, deliberately untracked
CLAUDE.md

# Build output. Unanchored on purpose: these now live under apps/*, so a
# leading-slash pattern would only match the repository root and miss them.
**/dist/
**/build/
**/bin/
**/out/

# Generated by apps/web/scripts/build-tests.ts
**/public/tests/

# C++ (apps/engine)
*.o
*.obj
*.so
*.a
*.exe
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
compile_commands.json
.cache/

# OpenTofu / Terraform (infra/).
#
# Unanchored on purpose. arrakis anchored these as `tofu/*.tfstate` and
# `tofu/.terraform/`, which matches only that one directory — so everything
# under `tofu/k8s/` was never ignored, and a terraform.tfstate holding a
# plaintext POSTGRES_PASSWORD plus 81 MB of provider binaries got committed.
# Never anchor these.
**/.terraform/
**/.terraform.lock.hcl.bak
**/*.tfstate
**/*.tfstate.*
**/terraform.tfvars
**/*.tfvars.json
crash.log

# kubeconfig holds client certificates
*.kubeconfig
kubeconfig*
