{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "api",
	"main": "src/index.ts",
	"compatibility_date": "2026-05-18",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			"id": "99045301314f4530817f32abff2f2445",
			"localConnectionString": "postgres://postgres:postgres@localhost:5433/lowlevellab"
		}
	],
	"assets": {
		"binding": "ASSETS",
		"directory": "./public"
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"vars": {
		"BETTER_AUTH_URL": "http://localhost:8787",
		"WEB_ORIGIN": "http://localhost:5173"
	},
	"env": {
		"dev": {
			"hyperdrive": [
				{
					"binding": "HYPERDRIVE",
					"id": "99045301314f4530817f32abff2f2445"
				}
			]
		}
	}
}